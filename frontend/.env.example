# Copy to .env.local for local development. This file is ignored by Git.
# Use only a Supabase anon/public publishable key here, never a service-role key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Or use the newer public publishable key instead:
# VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Optional; defaults to the local Skyline backend.
VITE_API_BASE_URL="http://localhost:3001/api"