generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Locked-in assumptions (plan approved without further product answers):
// - Single organization per database (no Organization tenant).
// - Auth is external; User has no password hash. When Supabase Auth is used, User.id is
//   auth.users.id (JWT sub). There is no Prisma FK into auth.users. Signup/sync must
//   pass that UUID; @default(uuid()) is only for local/seed rows that are not Auth users.
// - Roles stay a single UserRole enum (STUDENT, ADMIN, TREASURER) — one role per user.
//   Department heads and stacked duties need a later RBAC/assignment model; adding more
//   enum values would still not allow multiple responsibilities on one user.
// - Currency is INR (ISO 4217), stored per payment with org-wide default.
// - Guest checkout allowed: Payment.userId, Ticket.userId, MerchandiseOrder.userId, and
//   FundraiserDonation.userId are optional. Membership.userId stays required.
// - Payments are record-only (cash/card/online recorded here); no provider webhook tables yet. Payment.externalRef is the idempotency key.
// - Membership renewal inserts a new Membership row. Dues amount is snapshotted on the row (not a global settings table).
// - Merchandise has a single price (not member vs non-member).
// - Announcements are global to active members (no targeting table).
// - Ticket VALIDATED + validatedAt is attendance; no separate Attendance / walk-in table.
// - One user may hold multiple tickets per event (no unique user+event).
// - Event.cancelledAt and Product.isActive are used instead of generic soft-delete.
//
// Prisma 7.10.0 PSL does not support @@check. Intended integrity rules are documented
// on each model as named PostgreSQL CHECK constraints to add in a reviewed SQL
// migration (do not use db push).

enum UserRole {
  STUDENT
  ADMIN
  TREASURER

  @@map("user_role")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("membership_status")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  OTHER

  @@map("payment_method")
}

enum PaymentPurpose {
  MEMBERSHIP_DUES
  EVENT_TICKET
  MERCHANDISE
  FUNDRAISER

  @@map("payment_purpose")
}

enum TicketStatus {
  RESERVED
  PAID
  VALIDATED
  CANCELLED
  REFUNDED

  @@map("ticket_status")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("announcement_status")
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@map("fundraiser_status")
}

enum VolunteerTaskStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED

  @@map("volunteer_task_status")
}

enum AssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

enum PayoutStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID

  @@map("payout_status")
}

enum InventoryReason {
  SALE
  RESTOCK
  RETURN
  ADJUSTMENT

  @@map("inventory_reason")
}

enum FinancialEntryType {
  INCOME
  EXPENSE

  @@map("financial_entry_type")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  studentId String?  @unique @map("student_id")
  phone     String?
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships              Membership[]
  payments                 Payment[]
  tickets                  Ticket[]              @relation("TicketHolder")
  validatedTickets         Ticket[]              @relation("TicketValidator")
  createdEvents            Event[]
  announcements            Announcement[]
  merchandiseOrders        MerchandiseOrder[]
  inventoryMovements       InventoryMovement[]
  createdFundraisers       Fundraiser[]
  donations                FundraiserDonation[]
  createdVolunteerTasks    VolunteerTask[]
  volunteerAssignments     VolunteerAssignment[]
  submittedExpenses        Expense[]             @relation("ExpenseSubmitter")
  reviewedExpenses         Expense[]             @relation("ExpenseReviewer")
  claimedReimbursements    Reimbursement[]       @relation("ReimbursementClaimant")
  reviewedReimbursements   Reimbursement[]       @relation("ReimbursementReviewer")

  @@map("users")
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  status     MembershipStatus
  startsOn   DateTime         @map("starts_on") @db.Date
  expiresOn  DateTime         @map("expires_on") @db.Date
  duesAmount Decimal          @map("dues_amount") @db.Decimal(12, 2)
  paymentId  String?          @unique @map("payment_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([expiresOn])
  // CHECK membership_dates_check: expires_on >= starts_on
  @@map("memberships")
}

model Payment {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("INR") @db.Char(3)
  status      PaymentStatus
  method      PaymentMethod
  purpose     PaymentPurpose
  externalRef String?        @unique @map("external_ref")
  paidAt      DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership         Membership?
  tickets            Ticket[]
  merchandiseOrder   MerchandiseOrder?
  donation           FundraiserDonation?
  financialEntries   FinancialEntry[]

  @@index([userId, createdAt])
  @@index([purpose, status])
  // Ledger: Payment.amount is the original charge and is not replaced by a refund Payment.
  // Refunds are a compensating FinancialEntry EXPENSE on this same payment (not a new row
  // in payments). Status REFUNDED is a current-state flag; do not mutate FinancialEntry rows.
  // CHECK payment_amount_positive: amount > 0
  @@map("payments")
}

model Event {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  location        String?
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(6)
  capacity        Int
  memberPrice     Decimal   @map("member_price") @db.Decimal(12, 2)
  nonMemberPrice  Decimal   @map("non_member_price") @db.Decimal(12, 2)
  createdById     String    @map("created_by_id") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tickets        Ticket[]
  volunteerTasks VolunteerTask[]

  @@index([startsAt])
  @@index([createdById])
  // CHECK event_capacity_nonnegative: capacity >= 0
  // CHECK event_member_price_nonnegative: member_price >= 0
  // CHECK event_non_member_price_nonnegative: non_member_price >= 0
  @@map("events")
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  paymentId      String?      @map("payment_id") @db.Uuid
  status         TicketStatus
  pricePaid      Decimal      @map("price_paid") @db.Decimal(12, 2)
  pricedAsMember Boolean      @map("priced_as_member")
  validationCode String       @unique @map("validation_code")
  validatedAt    DateTime?    @map("validated_at") @db.Timestamptz(6)
  validatedById  String?      @map("validated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user        User?  @relation("TicketHolder", fields: [userId], references: [id], onDelete: Restrict)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  validatedBy User?  @relation("TicketValidator", fields: [validatedById], references: [id], onDelete: Restrict)

  @@index([eventId, status])
  @@index([userId, eventId])
  // CHECK ticket_price_nonnegative: price_paid >= 0
  @@map("tickets")
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  body        String
  status      AnnouncementStatus @default(DRAFT)
  createdById String             @map("created_by_id") @db.Uuid
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc)])
  @@map("announcements")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  size      String
  sku       String  @unique
  price     Decimal @db.Decimal(12, 2)
  stockQty  Int     @default(0) @map("stock_qty")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  movements InventoryMovement[]

  @@unique([productId, size])
  // CHECK variant_stock_nonnegative: stock_qty >= 0
  // CHECK variant_price_nonnegative: price >= 0
  @@map("product_variants")
}

model MerchandiseOrder {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  status      OrderStatus
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  paymentId   String?     @unique @map("payment_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([userId])
  // CHECK order_total_nonnegative: total_amount >= 0
  @@map("merchandise_orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  order              MerchandiseOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryMovement  InventoryMovement?

  @@unique([orderId, variantId])
  // CHECK order_item_quantity_positive: quantity > 0
  // CHECK order_item_unit_price_nonnegative: unit_price >= 0
  @@map("order_items")
}

model InventoryMovement {
  id           String          @id @default(uuid()) @db.Uuid
  variantId    String          @map("variant_id") @db.Uuid
  quantityDelta Int            @map("quantity_delta")
  reason       InventoryReason
  orderItemId  String?         @unique @map("order_item_id") @db.Uuid
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // CHECK inventory_delta_nonzero: quantity_delta <> 0
  // CHECK inventory_sale_check: reason <> 'SALE' OR (quantity_delta < 0 AND order_item_id IS NOT NULL)
  @@map("inventory_movements")
}

model Fundraiser {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String?
  goalAmount  Decimal          @map("goal_amount") @db.Decimal(12, 2)
  status      FundraiserStatus
  startsAt    DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?        @map("ends_at") @db.Timestamptz(6)
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy      User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  donations      FundraiserDonation[]
  volunteerTasks VolunteerTask[]

  // CHECK fundraiser_goal_nonnegative: goal_amount >= 0
  @@map("fundraisers")
}

model FundraiserDonation {
  id           String   @id @default(uuid()) @db.Uuid
  fundraiserId String   @map("fundraiser_id") @db.Uuid
  paymentId    String   @unique @map("payment_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fundraiser Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Restrict)
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  // CHECK donation_amount_positive: amount > 0
  @@map("fundraiser_donations")
}

model VolunteerTask {
  id           String              @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  slotsNeeded  Int                 @map("slots_needed")
  status       VolunteerTaskStatus
  eventId      String?             @map("event_id") @db.Uuid
  fundraiserId String?             @map("fundraiser_id") @db.Uuid
  startsAt     DateTime?           @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?           @map("ends_at") @db.Timestamptz(6)
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  event        Event?                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  fundraiser   Fundraiser?           @relation(fields: [fundraiserId], references: [id], onDelete: Restrict)
  assignments  VolunteerAssignment[]

  // CHECK volunteer_slots_positive: slots_needed > 0
  @@map("volunteer_tasks")
}

model VolunteerAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  taskId      String           @map("task_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      AssignmentStatus
  assignedAt  DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)

  task VolunteerTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@map("volunteer_assignments")
}

model Expense {
  id            String       @id @default(uuid()) @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  description   String
  category      String
  incurredOn    DateTime     @map("incurred_on") @db.Date
  receiptUrl    String?      @map("receipt_url")
  submittedById String       @map("submitted_by_id") @db.Uuid
  status        PayoutStatus
  reviewedById  String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  paidAt        DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  submittedBy     User             @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy      User?            @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  financialEntry  FinancialEntry?

  // CHECK expense_amount_positive: amount > 0
  @@map("expenses")
}

model Reimbursement {
  id           String       @id @default(uuid()) @db.Uuid
  claimantId   String       @map("claimant_id") @db.Uuid
  amount       Decimal      @db.Decimal(12, 2)
  description  String
  receiptUrl   String?      @map("receipt_url")
  status       PayoutStatus
  submittedAt  DateTime     @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  claimant        User             @relation("ReimbursementClaimant", fields: [claimantId], references: [id], onDelete: Restrict)
  reviewedBy      User?            @relation("ReimbursementReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  financialEntry  FinancialEntry?

  // CHECK reimbursement_amount_positive: amount > 0
  @@map("reimbursements")
}

model FinancialEntry {
  id              String             @id @default(uuid()) @db.Uuid
  type            FinancialEntryType
  amount          Decimal            @db.Decimal(12, 2)
  occurredAt      DateTime           @map("occurred_at") @db.Timestamptz(6)
  description     String
  paymentId       String?            @map("payment_id") @db.Uuid
  expenseId       String?            @unique @map("expense_id") @db.Uuid
  reimbursementId String?            @unique @map("reimbursement_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  reimbursement Reimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: Restrict)

  // One INCOME and at most one compensating EXPENSE (refund) per payment.
  // @@unique([paymentId, type]) prevents duplicate income. Do not insert a second Payment
  // for a refund. Ledger rows are append-only (no updates/deletes). Partial/per-line
  // refunds are not modeled — at most one EXPENSE per payment.
  @@unique([paymentId, type])
  // CHECK financial_entry_amount_positive: amount > 0
  // CHECK financial_entry_one_source: num_nonnulls(payment_id, expense_id, reimbursement_id) = 1
  // CHECK financial_entry_payment_exclusive: (payment_id IS NULL) OR (expense_id IS NULL AND reimbursement_id IS NULL)
  // CHECK financial_entry_expense_source: (expense_id IS NULL) OR (type = 'EXPENSE' AND payment_id IS NULL AND reimbursement_id IS NULL)
  // CHECK financial_entry_reimbursement_source: (reimbursement_id IS NULL) OR (type = 'EXPENSE' AND payment_id IS NULL AND expense_id IS NULL)
  @@map("financial_entries")
}
