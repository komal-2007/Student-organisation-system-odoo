PORT=3000
NODE_ENV=development

# Browser origin allowed by CORS (no wildcard). Example local frontend:
CORS_ORIGIN="http://localhost:5173"

# Pooled connection for the running app (Supabase transaction pooler, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Direct/session connection for Prisma CLI (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# External auth (Supabase Auth). User.id must equal the JWT "sub" claim.
# Provide JWKS via SUPABASE_URL (preferred for ECC/RSA project signing keys),
# and/or the legacy HS256 secret. Do not commit real values.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"
# Optional overrides; defaults are derived from SUPABASE_URL:
# JWT_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
# JWT_ISSUER="https://YOUR_PROJECT_REF.supabase.co/auth/v1"
JWT_AUDIENCE="authenticated"

# Snapshot used when inserting a new Membership row. This is not a payment capture.
MEMBERSHIP_DUES_AMOUNT="500.00"
MEMBERSHIP_PERIOD_DAYS="365"

# Razorpay (optional until checkout is used). Do not commit real values.
# Checkout returns 503 if KEY_ID/KEY_SECRET are unset. Webhooks return 503 if
# WEBHOOK_SECRET is unset.
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
